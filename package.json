{
  "name": "leaklens",
  "version": "0.1.0",
  "description": "Privacy-first, real-time sensitive data protection browser extension",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt dev",
    "dev:firefox": "wxt dev --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "build:edge": "wxt build --browser edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "zip:edge": "wxt zip --browser edge",
    "prepare": "wxt prepare",
    "check": "wxt check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src entrypoints",
    "lint:fix": "eslint src entrypoints --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"entrypoints/**/*.{ts,tsx,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"entrypoints/**/*.{ts,tsx,html}\"",
    "demo": "npx serve -l 8080 ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "@wxt-dev/module-react": "^1.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^6.3.4",
    "vitest": "^2.0.5",
    "wxt": "^0.21.4"
  }
}
